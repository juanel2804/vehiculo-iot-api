    {
      "name": "Prueba 2 — GET historial",
      "item": [
        {
          "name": "2.1 GET historial (máx. 10, más reciente primero)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/vehiculos/1/historial",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "vehiculos",
                "1",
                "historial"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = pm.response.json();",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Máximo 10 movimientos\", () => pm.expect(h.length).to.be.at.most(10));",
                  "pm.test(\"Del más reciente al más antiguo\", () => { for (let i = 1; i < h.length; i++) pm.expect(h[i-1].id_historial).to.be.above(h[i].id_historial); });",
                  "pm.test(\"Sin movimientos DEMO\", () => h.forEach(x => pm.expect(String(x.origen).toUpperCase()).to.not.include(\"DEMO\")));"
                ]
              }
            }
          ]
        }
      ]
    },
