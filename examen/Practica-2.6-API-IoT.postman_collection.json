        {
          "name": "1.1 POST movimiento RETROCEDER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/movimientos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "movimientos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_vehiculo\": 1,\n  \"id_comando\": 2,\n  \"origen\": \"POSTMAN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve el comando\", () => pm.expect(pm.response.json()).to.have.property(\"comando\"));"
