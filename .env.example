# Copia este archivo como .env y llena tus valores. NUNCA subas .env a GitHub.
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=api_iot
DB_PASSWORD=cambia-esta-contrasena
DB_POOL_SIZE=5
# Llave que deben mandar en el header X-API-Key las operaciones destructivas y de control
API_KEY=cambia-esta-llave
# Páginas web que pueden llamar a la API desde el navegador (separadas por coma)
CORS_ORIGINS=https://juanel2804.github.io
# Copiloto con Claude (opcional). Sin esta llave, POST /vehiculos/{id}/copiloto responde 503.
ANTHROPIC_API_KEY=
